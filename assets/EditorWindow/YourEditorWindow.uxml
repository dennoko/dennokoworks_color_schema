<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">

    <!-- ───────── 標準ヘッダー: トップバー (references/window-guide.md「標準ヘッダー」) ─────────
         左: ツール名 + バージョン + ↻ / 右: 言語 (切り替え先を表示) + マニュアル + 設定 ⋮。
         要らない要素は消してよい (言語を切り替えないツールは appbar-lang を消す)。
         アイコンと動作は DennokoAppBar、バージョンの文言は version-check-guide.md の ApplyVersionLabel が入れる -->
    <ui:VisualElement name="appbar" class="dennoko-appbar">
        <ui:VisualElement class="dennoko-appbar__title">
            <ui:Label name="appbar-title" text="YOUR TOOL NAME" class="dennoko-title" />
            <ui:Label name="version-label" text="" class="dennoko-version-label" />
            <ui:Button name="version-reload-button" class="dennoko-icon-button" />
        </ui:VisualElement>
        <ui:VisualElement class="dennoko-appbar__actions">
            <ui:Button name="appbar-lang" text="EN" class="dennoko-appbar-lang" />
            <ui:Button name="appbar-manual" class="dennoko-icon-button" />
            <ui:Button name="appbar-settings" class="dennoko-icon-button" />
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- 設定エリア (スクロール可能)。ウィンドウ縮小時はここだけが縮む -->
    <ui:ScrollView class="dennoko-scroll">

        <!-- 常時表示セクション -->
        <ui:VisualElement class="dennoko-card">
            <ui:Label text="INPUT" class="dennoko-section-title dennoko-card-header" />
            <uie:ObjectField label="Source" name="source-field"
                type="UnityEngine.Texture2D, UnityEngine.CoreModule" />
        </ui:VisualElement>

        <!-- ON/OFF トグル付きセクション (OFF で折りたたまれる)
             中身には .dennoko-toggle-section__content を付ける -->
        <ui:VisualElement class="dennoko-card">
            <ui:VisualElement class="dennoko-card-header dennoko-toggle-header">
                <ui:Toggle name="color-correction-toggle" text="COLOR CORRECTION"
                    value="true" class="dennoko-section-title" />
                <ui:Button name="color-correction-reset" text="Reset" />
            </ui:VisualElement>
            <ui:VisualElement name="color-correction-content" class="dennoko-toggle-section__content">
                <ui:Slider label="Hue" name="hue-slider"
                    low-value="-180" high-value="180" show-input-field="true" />
                <ui:Slider label="Saturation" name="sat-slider"
                    low-value="0" high-value="2" value="1" show-input-field="true" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:ScrollView>

    <!-- ───────── 標準フッター (references/window-guide.md「標準フッター」) ─────────
         [出力ドック (任意)] → [フッター] → [ステータス] の順に、スクロール領域の下へ固定する。
         出力ドック: 出力先など 2 行まで。出力しないツールは丸ごと消し、フッターの joined 修飾クラスも外す -->
    <ui:VisualElement name="output-dock" class="dennoko-output">
        <ui:VisualElement class="dennoko-output-row">
            <ui:Label text="出力先" class="dennoko-output__label" />
            <ui:TextField name="output-path" value="Assets" readonly="true" class="dennoko-field-readonly" />
            <ui:Button name="output-browse" text="選択…" class="dennoko-output__action" />
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- フッター: カードで囲まず上罫線だけで仕切る (出力ドックの直後は joined 修飾クラスで罫線を重ねない)。
         左に固定幅の Secondary、右に伸びる Primary (画面に 1 つ)。件数などは .dennoko-footer__info を左端に置く -->
    <ui:VisualElement class="dennoko-footer dennoko-footer--joined">
        <ui:Button name="reset-all-button" text="Reset All" class="dennoko-button-secondary" />
        <ui:Button name="apply-button" text="Apply &amp; Save" class="dennoko-button-primary" />
    </ui:VisualElement>

    <!-- ステータスバー: 文言と状態は DennokoStatus で切り替える (子要素を足さない) -->
    <ui:Label name="status-label" text="Ready" class="dennoko-status" />

</ui:UXML>
