<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <!-- P1 変換: 入力を選び、設定して、1 回出力する (NormalMapGenerator 風) -->

    <!-- ───────── トップバー ───────── -->
    <ui:VisualElement name="appbar" class="dennoko-appbar">
        <ui:VisualElement class="dennoko-appbar__title">
            <ui:Label name="appbar-title" text="Normal Map Generator" class="dennoko-title" />
            <ui:Label name="version-label" text="v1.2.0" class="dennoko-version-label" />
            <ui:Button name="version-reload-button" class="dennoko-icon-button" />
        </ui:VisualElement>
        <ui:VisualElement class="dennoko-appbar__actions">
            <ui:Button name="appbar-lang" text="EN" class="dennoko-appbar-lang" />
            <ui:Button name="appbar-manual" class="dennoko-icon-button" />
            <ui:Button name="appbar-settings" class="dennoko-icon-button" />
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:ScrollView name="main-scroll" class="dennoko-scroll">

        <!-- B1 対象カード (見出しなし) -->
        <ui:VisualElement name="target-card" class="dennoko-card dennoko-target-card" style="margin-top: 8px;">
            <ui:VisualElement class="dennoko-target-row">
                <uie:ObjectField name="target-field" type="UnityEngine.Texture2D, UnityEngine.CoreModule" />
                <ui:Button name="target-from-selection" text="選択から" tooltip="Project ビューで選択中のテクスチャを入れる" class="dennoko-target-row__action" />
            </ui:VisualElement>
            <ui:VisualElement name="target-info" class="dennoko-info-row">
                <ui:Label name="target-info-size" text="2048 × 2048" />
                <ui:Label name="target-info-format" text="RGBA32" />
                <ui:Label name="target-info-color" text="sRGB" />
            </ui:VisualElement>
            <ui:VisualElement name="target-warning" class="dennoko-inline-warning">
                <ui:Label text="Read/Write が無効です" class="dennoko-inline-warning__text" />
                <ui:Button name="target-fix" text="有効にする" class="dennoko-inline-warning__action" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- B2 設定カード -->
        <ui:VisualElement name="options-card" class="dennoko-card dennoko-options-card">
            <ui:VisualElement class="dennoko-card-header dennoko-card-header--row">
                <ui:Label text="生成" class="dennoko-section-title dennoko-card-header__title" />
                <ui:Button name="options-help" class="dennoko-icon-button" />
                <ui:Button name="options-reset" class="dennoko-icon-button" />
            </ui:VisualElement>
            <ui:Slider name="opt-strength" label="強さ" low-value="0" high-value="10" value="2" show-input-field="true" />
            <ui:Slider name="opt-blur" label="ぼかし" low-value="0" high-value="8" value="1" show-input-field="true" />
            <ui:VisualElement class="dennoko-field-row">
                <ui:Label text="高さ" class="dennoko-field-row__label" />
                <ui:VisualElement name="opt-height" class="dennoko-segmented dennoko-choice-group">
                    <ui:Button text="明るい = 高い" />
                    <ui:Button text="暗い = 高い" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Toggle name="opt-invert-g" text="G を反転 (DirectX 形式)" value="false" />

            <!-- 詳細: 閉じている間は初期値と違う項目だけをチップで要約 -->
            <ui:VisualElement name="opt-details" class="dennoko-details dennoko-details--collapsed">
                <ui:VisualElement name="opt-details-header" class="dennoko-details__header">
                    <ui:Label name="opt-details-arrow" text="▶" class="dennoko-details__arrow" />
                    <ui:Label text="詳細" class="dennoko-details__title" />
                    <ui:VisualElement name="opt-details-chips" class="dennoko-details__chips" />
                </ui:VisualElement>
                <ui:VisualElement class="dennoko-details__content">
                    <ui:DropdownField name="opt-sample" label="サンプリング" />
                    <ui:DropdownField name="opt-wrap" label="端の扱い" />
                    <ui:Toggle name="opt-mip" text="ミップマップを生成" value="true" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- B3 プレビューカード -->
        <ui:VisualElement name="preview-card" class="dennoko-card dennoko-preview-card">
            <ui:VisualElement name="preview" class="dennoko-preview">
                <ui:VisualElement name="preview-image" class="dennoko-preview__image" />
                <ui:Label name="preview-message" text="入力を選ぶとここに表示されます" class="dennoko-preview__message" />
                <ui:VisualElement name="preview-progress" class="dennoko-preview__progress" />
                <ui:Button name="preview-stale" text="更新" tooltip="設定が変わりました。クリックでプレビューを更新" class="dennoko-preview__stale" />
                <ui:VisualElement class="dennoko-preview__toolbar">
                    <ui:Button name="preview-fit" class="dennoko-icon-button" />
                    <ui:Button name="preview-channel" class="dennoko-icon-button" />
                    <ui:Button name="preview-popout" class="dennoko-icon-button" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="dennoko-info-row">
                <ui:Label name="preview-info" text="—" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:ScrollView>

    <!-- ───────── B5 出力ドック (2 行まで) ───────── -->
    <ui:VisualElement name="output-dock" class="dennoko-output">
        <ui:VisualElement class="dennoko-output-row">
            <ui:Label text="出力先" class="dennoko-output__label" />
            <ui:TextField name="output-path" value="Assets/Textures/Generated" readonly="true" class="dennoko-field-readonly" />
            <ui:Button name="output-browse" text="選択…" class="dennoko-output__action" />
        </ui:VisualElement>
        <ui:VisualElement class="dennoko-output-row">
            <ui:Label text="形式" class="dennoko-output__label" />
            <ui:VisualElement name="output-format" class="dennoko-segmented dennoko-choice-group">
                <ui:Button text="PNG" />
                <ui:Button text="TGA" />
            </ui:VisualElement>
            <ui:VisualElement class="dennoko-spacer" />
            <ui:Toggle name="output-overwrite" text="上書き" value="true" />
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- ───────── フッター (主ボタン 1 つ) ───────── -->
    <ui:VisualElement class="dennoko-footer dennoko-footer--joined">
        <ui:Button name="primary-button" text="生成" class="dennoko-button-primary" />
    </ui:VisualElement>
    <ui:Label name="status-label" text="Ready" class="dennoko-status" />
</ui:UXML>
